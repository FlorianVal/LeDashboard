{
  "name": "@ledashboard/ledashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Home metrics dashboard",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:server": "npm --workspace @ledashboard/server run dev",
    "dev:web": "npm --workspace @ledashboard/web run dev",
    "build": "npm --workspace @ledashboard/shared run build && npm --workspace @ledashboard/server run build && npm --workspace @ledashboard/web run build",
    "test": "vitest run --exclude 'e2e/**'",
    "test:watch": "vitest --exclude 'e2e/**'",
    "typecheck": "npm --workspace @ledashboard/shared run build -- --build --force && npm --workspaces --if-present run typecheck"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlorianVal/LeDashboard.git"
  },
  "author": "Florian Valade",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.10"
  }
}
